# ==========================================
# RakshaTrack — Environment Configuration
# SGT University Transport Safety System
# ==========================================

# Mode
# In Demo Mode (default), software controls simulate all hardware and GPS telemetry in memory.
VITE_DEMO_MODE=true

# Database Persistence (Optional)
# Configure a Neon PostgreSQL connection string to persist records to a live database:
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# Clerk Authentication (Optional)
# If provided, real Clerk authentication is mounted. If empty, the app runs in Demo Role Switcher mode.
# VITE_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
# CLERK_SECRET_KEY="your_clerk_secret_key"
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Transport Geofence Thresholds
VITE_PROXIMITY_THRESHOLD_METERS=150
VITE_SIMULATION_UPDATE_INTERVAL_MS=2000
